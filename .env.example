# Existing COCCE Supabase project. Replace placeholders only in an ignored local env file.
VITE_COCCE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_COCCE_SUPABASE_ANON_KEY=your-public-anon-or-publishable-key

# Local default stays false. Set true only in a deployment configured for the applied Office schema.
VITE_OFFICE_TEAM_SCHEMA_READY=false
