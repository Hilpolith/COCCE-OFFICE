{
  "name": "cocce-office",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest run --maxWorkers=4 && node --test scripts/office-profile-privacy-check.mjs scripts/office-ai-api-check.mjs scripts/office-cloud-boundaries.mjs scripts/office-cloud-postgres-check.mjs scripts/office-school-sms-postgres-check.mjs",
    "preview": "vite preview",
    "test:office-schema": "node --test scripts/office-profile-privacy-check.mjs",
    "test:office-ai-api": "node --test scripts/office-ai-api-check.mjs",
    "test:office-cloud": "vitest run supabase/functions/office-cloud-files/core.test.ts && node --test scripts/office-cloud-boundaries.mjs scripts/office-cloud-postgres-check.mjs",
    "test:office-school-sms": "node --test scripts/office-school-sms-postgres-check.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "@tiptap/core": "^3.32.2",
    "@tiptap/extension-table": "^3.32.2",
    "@tiptap/extension-underline": "^3.32.2",
    "@tiptap/pm": "^3.32.2",
    "@tiptap/react": "^3.32.2",
    "@tiptap/starter-kit": "^3.32.2",
    "docx": "9.15.1",
    "fflate": "0.8.3",
    "lucide-react": "^1.66.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.14",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.7",
    "happy-dom": "^21.0.4",
    "oxlint": "^1.89.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
